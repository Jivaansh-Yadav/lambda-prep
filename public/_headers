# Security headers. These are also applied by src/server.ts (the SSR entry), so
# this block matters only on hosts that read `_headers` (Cloudflare Pages /
# Netlify). Keep the two in sync: the public CSP below is
# contentSecurityPolicy("/") and the /admin block is contentSecurityPolicy
# for the admin path, which refuses to be framed at all.
#
# No X-Frame-Options: an enforced CSP frame-ancestors supersedes it, and
# SAMEORIGIN here would silently block the Eazo preview iframe (the reason it
# was removed from src/server.ts as well).
/*
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; script-src 'self' 'unsafe-inline' https://static.cloudflareinsights.com; script-src-attr 'none'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https://drive.google.com; connect-src 'self' https://cloudflareinsights.com; frame-src 'self' https://drive.google.com https://docs.google.com; worker-src 'self' blob:; form-action 'self'; frame-ancestors 'self' https://*.e2b.app https://*.eazo.dev https://*.eazo.ai
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), fullscreen=(self "https://drive.google.com")
  Cross-Origin-Opener-Policy: same-origin

# The admin panel is never embedded — not by the Eazo preview hosts either.
/admin*
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; script-src 'self' 'unsafe-inline' https://static.cloudflareinsights.com; script-src-attr 'none'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https://drive.google.com; connect-src 'self' https://cloudflareinsights.com; frame-src 'self' https://drive.google.com https://docs.google.com; worker-src 'self' blob:; form-action 'self'; frame-ancestors 'none'

/assets/*
  Cache-Control: public, max-age=31536000, immutable

# OG image, favicon and logo rarely change but aren't content-hashed, so use
# a long max-age with revalidation instead of `immutable` — a new deploy with
# the same filename will still be picked up once the cache expires/revalidates.
/og/*
  Cache-Control: public, max-age=604800, must-revalidate

/favicon.svg
  Cache-Control: public, max-age=604800, must-revalidate

/lambda-prep-logo.svg
  Cache-Control: public, max-age=604800, must-revalidate

# Hero photograph, also served straight out of public/ (see src/lib/brand.ts).
/student-studying.jpg
  Cache-Control: public, max-age=604800, must-revalidate

# robots.txt / sitemap.xml are crawled frequently and can change (new
# routes), so keep them revalidating on every request rather than cached.
/robots.txt
  Cache-Control: public, max-age=0, must-revalidate

/sitemap.xml
  Cache-Control: public, max-age=0, must-revalidate
